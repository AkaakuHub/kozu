{
  "name": "kozu",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "pnpm run typecheck && vp build",
    "db:migrate:local": "cf d1 migrations apply 3d98cf76-3bfa-4d7e-8997-c846199a0d45 --local",
    "db:migrate:remote": "cf d1 migrations apply 3d98cf76-3bfa-4d7e-8997-c846199a0d45",
    "typecheck": "cf workers types && tsgo --noEmit",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "unused": "knip",
    "test": "vp test run",
    "test:core": "node --experimental-strip-types --test tests/core.test.ts",
    "check": "cf workers types && vp check && pnpm run unused && pnpm run test:core && vp test run && vp build",
    "hooks": "vp hooks enable"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "7.3.4",
    "diff": "^9.0.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.74.0",
    "midi-file": "^1.2.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "smplr": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "latest",
    "cf": "1.0.0-rc.0",
    "knip": "latest",
    "vite-plus": "latest"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.10.1"
}
